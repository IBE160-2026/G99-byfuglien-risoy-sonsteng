# Auto-oppdag tekstfiler og normaliser linjeskift til LF
* text=auto eol=lf

# Sørg for at disse alltid behandles som tekst med LF
*.md text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binærfiler skal ikke normaliseres
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
